# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # Standard Flutter convention: disable code signing for ALL pod targets.
      # Xcode Cloud / the Runner app re-signs everything during archiving.
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ''
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
    end
  end

  # ── Patch pre-compiled frameworks missing a platform load command ──────────
  # Xcode 16+ dropped the -ld_classic linker. The new linker (ld_prime) treats
  # "no platform load command" as a hard error for frameworks like MLKit 3.0.0.
  # Fix: use xcrun vtool to inject the iOS build-version into every affected
  # binary, then ad-hoc re-sign so the binary stays valid until Xcode Cloud
  # replaces it with the distribution signature during archiving.
  puts "=== Patching frameworks missing platform load commands ==="
  pods_root = installer.sandbox.root.to_s

  Dir.glob(File.join(pods_root, '**', '*.framework')).each do |fw_path|
    fw_name = File.basename(fw_path, '.framework')
    binary  = File.join(fw_path, fw_name)
    next unless File.exist?(binary)
    next unless `file "#{binary}" 2>/dev/null`.include?('Mach-O')

    build_info = `xcrun vtool -show-build "#{binary}" 2>/dev/null`
    next if build_info.match?(/PLATFORM/i)

    puts "  Patching: #{fw_name}"
    # Remove existing ad-hoc / dev signature (vtool will invalidate it)
    system("xcrun codesign --remove-signature \"#{binary}\" 2>/dev/null")
    # Inject iOS platform load command for arm64 (device slice)
    system("xcrun vtool -arch arm64 -set-build-version ios 15.0 15.0 -replace -output \"#{binary}\" \"#{binary}\" 2>/dev/null")
    # Restore an ad-hoc signature so Xcode can load the binary
    system("xcrun codesign -f -s - \"#{binary}\" 2>/dev/null")
    puts "    ✅ Done"
  end
  puts "=== Framework patching complete ==="
end
