# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # Disable code signing for resource bundles only (not app targets).
      # Applying CODE_SIGNING_ALLOWED=NO globally breaks App Store Connect upload.
      if target.respond_to?(:product_type) && target.product_type == "com.apple.product-type.bundle"
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
        config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ''
      end

      # Fix for MLKit/Google frameworks that lack a platform load command.
      # -ld_classic is deprecated in Xcode 16+; use linker flags to suppress the
      # "no platform load command" warning instead.
      if target.name.include?('MLKit') || target.name.include?('GoogleMLKit') ||
         target.name.include?('mlkit') || target.name.include?('GoogleDataTransport') ||
         target.name.include?('GTMSessionFetcher') || target.name.include?('SDWebImage')
        config.build_settings['OTHER_LDFLAGS'] = '$(inherited) -w'
      end
    end
  end

  # Patch pre-compiled MLKit frameworks to inject the iOS platform version
  # so the linker no longer warns "no platform load command found".
  require 'open3'
  mlkit_fw_dir = File.join(installer.sandbox.root, 'MLKitTextRecognitionCommon', 'Frameworks')
  if Dir.exist?(mlkit_fw_dir)
    Dir.glob(File.join(mlkit_fw_dir, '**', '*.framework')).each do |fw|
      binary = File.join(fw, File.basename(fw, '.framework'))
      if File.exist?(binary)
        stdout, stderr, status = Open3.capture3("vtool -show-build \"#{binary}\" 2>&1")
        unless stdout.include?('platform iOS') || stdout.include?('IPHONE')
          system("vtool -arch arm64 -set-build-version ios 15.0 15.0 -replace -output \"#{binary}\" \"#{binary}\" 2>/dev/null || true")
          system("vtool -arch x86_64 -set-build-version iossimulator 15.0 15.0 -replace -output \"#{binary}\" \"#{binary}\" 2>/dev/null || true")
        end
      end
    end
  end
end
